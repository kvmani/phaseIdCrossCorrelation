      "euler_deg.phi2",
      "image_meta.bit_depth",
      "image_meta.height",
      "image_meta.width",
      "manual_label_source"
    ],
    "common_mistakes": [
      "Mixing PHI and phi (use key PHI exactly as shown).",
      "Using phase names with spaces; always use canonical phase slugs.",
      "Using angles in radians; all angles must be degrees.",
      "Forgetting to update expected_phase after copying a case block."
    ],
    "recommended_exp_filename_pattern": "{phase_slug}_Ori_{id}.{ext}",
    "filename_note": "Filenames are relaxed; metadata in this manifest is the source of truth."
  },
